{
  "name": "ostiarius",
  "version": "0.1.0",
  "private": true,
  "description": "LUDIARS Ostiarius — venue LAN check-in gateway (offline passkey assertion + Ed25519 attestation)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.secrets --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env.secrets --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "tls:issue": "tsx server/acme/cli.ts issue",
    "tls:renew": "tsx server/acme/cli.ts renew"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@simplewebauthn/server": "^13.3.0",
    "acme-client": "^5.4.0",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.12.23",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
